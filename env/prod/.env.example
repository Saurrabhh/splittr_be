# Note: In production (e.g., Vercel / Cloud Run), environment variables should be injected 
# directly in your dashboard or hosting environment rather than loaded from files.
# Never commit actual production credentials/secrets to Git.

PORT=8080
DATABASE_URL=postgres://<prod-db-user>:<prod-db-password>@<prod-db-host>:5432/splittr?sslmode=require
GOOGLE_APPLICATION_CREDENTIALS=firebase-key.json

# Swagger UI Credentials (Required in production)
SWAGGER_USER=admin
SWAGGER_PASSWORD=<secure-swagger-password>

# Cloudinary Image Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=<prod-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<prod-cloudinary-api-key>
CLOUDINARY_API_SECRET=<prod-cloudinary-api-secret>


